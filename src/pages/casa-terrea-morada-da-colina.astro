---
/* Landing page de funil do CA5635 — casa térrea de 4 suítes no Morada da Colina.
   Percurso guiado: o visitante responde, a página reage, e o que ele vê depende
   do caminho. Quem chega no fim decidido viu as 20 fotos; quem está pesquisando
   vê 14. O canonical aponta para a ficha, que continua sendo a página oficial
   do imóvel — a LP não disputa busca com ela. */
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import LP from '../layouts/LP.astro';
import { fotosDe, precoBR } from '../lib/fotos';
import { CONTATO } from '../lib/site';

const imoveis = await getCollection('imoveis');
const imovel = imoveis.find((i) => i.data.codigo === 'CA5635')!;
const d = imovel.data;
const fotos = fotosDe(d.fotos, d.capa);

/* fotosDe() devolve a capa primeiro; aqui a ordem tem de ser a do arquivo,
   porque as sequências abaixo se referem ao número da foto. */
const emOrdem = fotosDe(d.fotos);
const minis = await Promise.all(
  emOrdem.map((f) => getImage({ src: f, width: 800, widths: [420, 800], format: 'webp' }))
);
const grandes = await Promise.all(
  emOrdem.map((f) => getImage({ src: f, width: 1600, format: 'webp' }))
);
const ogJpg = await getImage({ src: fotos[0], width: 1200, format: 'jpg' });

/* Legendas conferidas foto a foto contra o acervo. Nada aqui é suposição:
   o que não dá para afirmar da imagem ficou em termo neutro. */
const LEGENDAS = [
  'Sala com saída para o jardim',
  'Salão com churrasqueira',
  'Sala em três ambientes',
  'Jantar com pendente',
  'Estar com porta de vidro',
  'Sala',
  'Espaço gourmet',
  'Corredor das suítes',
  'Suíte com saída ao jardim',
  'Suíte com armário',
  'Armários planejados',
  'Suíte ampla',
  'Sala com bancada',
  'Cozinha com marcenaria',
  'Área externa lateral',
  'Piscina',
  'Pergolado',
  'Banheiro de suíte',
  'Banheiro',
  'Banheiro de suíte',
];

/* Ordem em que as fotos se revelam, conforme o que o visitante disse que mais
   pesa. Números da foto, não índices. */
const SEQUENCIAS: Record<string, number[]> = {
  andar:   [8, 1, 3, 5, 4, 9, 10, 12, 6, 13, 2, 14, 11, 7, 16, 17, 18, 20, 19, 15],
  receber: [16, 7, 2, 17, 1, 5, 15, 4, 3, 13, 6, 14, 8, 9, 10, 12, 11, 18, 20, 19],
  suites:  [8, 9, 10, 12, 11, 18, 20, 19, 1, 5, 3, 4, 6, 13, 2, 14, 7, 16, 17, 15],
  terreno: [16, 17, 15, 7, 2, 1, 5, 3, 4, 8, 9, 10, 12, 6, 13, 14, 11, 18, 20, 19],
};

/* peso = temperatura do lead · fotos = quanto o bloco seguinte libera */
const ETAPAS = [
  {
    id: 'moradores',
    numero: 'Pergunta 1 de 6',
    pergunta: 'Quem vai morar na casa?',
    apoio: 'Começo por aqui porque é o que mais muda o que vale a pena te mostrar.',
    opcoes: [
      { id: 'filhos', txt: 'Família com filhos em casa', peso: 0, fotos: 3,
        eco: 'Então quarto de verdade para cada um pesa mais que metro quadrado de sala. São quatro suítes, todas com armário planejado.' },
      { id: 'casal', txt: 'Casal, com quartos para receber', peso: 0, fotos: 3,
        eco: 'Casa grande para dois costuma sobrar quarto — e aqui sobra do jeito certo: quatro suítes, cada uma com armário planejado.' },
      { id: 'tresgeracoes', txt: 'Família grande, com pais ou sogros junto', peso: 0, fotos: 3,
        eco: 'Nesse caso o mesmo andar deixa de ser conforto e vira necessidade. Esta casa é térrea: não tem escada em lugar nenhum.' },
      { id: 'recebe', txt: 'Somos poucos, mas recebemos muito', peso: 0, fotos: 3,
        eco: 'Aí o que decide é o que fica em volta da casa. O terreno tem 592 m² e a casa ocupa 284 — o resto virou área de lazer.' },
    ],
  },
  {
    id: 'pesa',
    numero: 'Pergunta 2 de 6',
    pergunta: 'O que mais pesa na sua escolha?',
    apoio: 'Escolha o que você olharia primeiro numa visita.',
    opcoes: [
      { id: 'andar', txt: 'Ser tudo no mesmo andar, sem escada', peso: 0, fotos: 4,
        eco: 'Então vou começar por dentro. São 284 m² construídos e nenhum degrau entre a sala e o último quarto.' },
      { id: 'receber', txt: 'Ter espaço para receber', peso: 0, fotos: 4,
        eco: 'Então vou começar pela área de lazer: piscina aquecida, churrasqueira e pergolado.' },
      { id: 'suites', txt: 'O número de suítes', peso: 0, fotos: 4,
        eco: 'São quatro, todas com armário planejado. Vou te mostrar o corredor e os quartos primeiro.' },
      { id: 'terreno', txt: 'O tamanho do terreno', peso: 0, fotos: 4,
        eco: 'São 592 m² de terreno para 284 m² de casa. Vou começar pela parte de fora.' },
    ],
  },
  {
    id: 'prazo',
    numero: 'Pergunta 3 de 6',
    pergunta: 'Em quanto tempo você pretende mudar?',
    apoio: 'Não tem resposta errada aqui. Só muda o meu jeito de te ajudar.',
    opcoes: [
      { id: 'ate3', txt: 'Até 3 meses', peso: 25, fotos: 4,
        eco: 'Prazo curto pede visita rápida, porque casa térrea grande no bairro não fica muito tempo disponível.' },
      { id: '3a6', txt: 'De 3 a 6 meses', peso: 18, fotos: 3,
        eco: 'É um prazo bom: dá para visitar com calma e ainda decidir sem correria.' },
      { id: 'ano', txt: 'Ainda este ano', peso: 10, fotos: 2,
        eco: 'Então vale conhecer agora e usar esta casa como régua para comparar as próximas.' },
      { id: 'pesquisa', txt: 'Sem prazo, estou pesquisando', peso: 3, fotos: 2,
        eco: 'Faz sentido. No seu lugar eu também olharia bastante antes de mexer numa decisão desse tamanho.' },
    ],
  },
  {
    id: 'venda',
    numero: 'Pergunta 4 de 6',
    pergunta: 'Nessa mudança, você tem um imóvel para vender?',
    apoio: 'É o que costuma definir o prazo de verdade.',
    opcoes: [
      { id: 'javenda', txt: 'Sim, e já está à venda', peso: 15, fotos: 3,
        eco: 'Bom saber. Com o seu já anunciado, dá para alinhar as duas pontas desde o começo.' },
      { id: 'aindanao', txt: 'Sim, mas ainda não coloquei', peso: 10, fotos: 2,
        eco: 'Vale conversarmos sobre isso: colocar o seu no lugar certo costuma encurtar bastante o caminho.' },
      { id: 'direta', txt: 'Não, é compra direta', peso: 20, fotos: 3,
        eco: 'Então o processo é bem mais simples: depende só da sua decisão.' },
    ],
  },
  {
    id: 'pagamento',
    numero: 'Pergunta 5 de 6',
    pergunta: 'Como você pretende pagar?',
    apoio: 'Só para eu já chegar na conversa sabendo por onde começar.',
    opcoes: [
      { id: 'avista', txt: 'À vista', peso: 25, fotos: 3, eco: 'Anotado.' },
      { id: 'misto', txt: 'Parte à vista, parte financiada', peso: 20, fotos: 3, eco: 'Anotado.' },
      { id: 'banco', txt: 'Financiamento bancário', peso: 18, fotos: 3, eco: 'Anotado.' },
      { id: 'avaliando', txt: 'Ainda estou avaliando', peso: 8, fotos: 2,
        eco: 'Tranquilo. Isso é conversa de mesa, com número na frente — não de página na internet.' },
    ],
  },
  {
    id: 'visita',
    numero: 'Pergunta 6 de 6',
    pergunta: 'Você gostaria de conhecer a casa pessoalmente?',
    apoio: 'Foto e vídeo mostram muito, mas o tamanho a gente só sente andando dentro.',
    opcoes: [
      { id: 'semana', txt: 'Quero marcar esta semana', peso: 30, fotos: 3, eco: '' },
      { id: 'depois', txt: 'Quero, mas mais para frente', peso: 15, fotos: 2, eco: '' },
      { id: 'infoantes', txt: 'Prefiro receber mais informações antes', peso: 8, fotos: 1, eco: '' },
    ],
  },
];

const canonicalFicha = new URL('/imovel/casa-morada-da-colina-ca5635/', Astro.site).href;
const urlLp = new URL('/casa-terrea-morada-da-colina/', Astro.site).href;
const descricao =
  'Casa térrea à venda no Morada da Colina, Uberlândia — 284 m² construídos em terreno de 592 m², 4 suítes com armário planejado, piscina aquecida e 3 vagas. Veja o vídeo da casa inteira e fale direto com o corretor.';

const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Casa térrea de 4 suítes no Morada da Colina — vídeo da casa inteira',
  description:
    'Percurso completo pela casa térrea de 284 m² no Morada da Colina, Uberlândia: sala em três ambientes, cozinha, as quatro suítes, piscina aquecida e área externa.',
  thumbnailUrl: [new URL('/video/ca5635-tour-poster.jpg', Astro.site).href],
  contentUrl: new URL('/video/ca5635-tour.mp4', Astro.site).href,
  uploadDate: '2026-08-12',
  duration: 'PT41S',
};
const listingLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: d.titulo,
  description: descricao,
  url: canonicalFicha,
  mainEntityOfPage: urlLp,
  image: grandes.map((g) => new URL(g.src, Astro.site).href),
  numberOfRooms: d.dormitorios,
  floorSize: { '@type': 'QuantitativeValue', value: d.areaUtil, unitCode: 'MTK' },
  offers: {
    '@type': 'Offer', price: d.preco, priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock', url: canonicalFicha,
  },
  address: {
    '@type': 'PostalAddress', addressLocality: 'Uberlândia',
    addressRegion: 'MG', addressCountry: 'BR',
  },
};

const dadosJs = {
  etapas: ETAPAS.map((e) => ({
    id: e.id,
    opcoes: e.opcoes.map((o) => ({ id: o.id, txt: o.txt, peso: o.peso, fotos: o.fotos })),
  })),
  sequencias: SEQUENCIAS,
  wa: CONTATO.whatsappNum,
};
---

<LP
  title="Casa térrea de 4 suítes no Morada da Colina, Uberlândia | Portfólio Negócios"
  description={descricao}
  image={ogJpg.src}
  canonical={canonicalFicha}
  jsonLd={[listingLd, videoLd]}
>
  <div class="lp-progresso" aria-hidden="true"><span id="barra"></span></div>

  <!-- ————————————————— ABERTURA ————————————————— -->
  <header class="lp-hero">
    <div class="lp-hero-in">
      <div class="lp-hero-topo">
        <p class="rotulo lp-hero-rot">Morada da Colina · Uberlândia · Ref. {d.codigo}</p>
        <h1>Casa térrea de 4&nbsp;suítes no Morada da Colina</h1>
      </div>

      <figure class="lp-hero-video">
        <video
          src="/video/ca5635-tour.mp4"
          poster="/video/ca5635-tour-poster.jpg"
          playsinline muted loop autoplay controls preload="metadata"
          aria-label="Vídeo do percurso completo pela casa"
        ></video>
        <figcaption class="rotulo">Casa inteira, sem corte de edição de anúncio</figcaption>
      </figure>

      <div class="lp-hero-texto">
        <p class="lp-hero-lead">
          Quem procura casa térrea grande na Zona Sul sabe como é difícil aparecer uma.
          Esta tem 284&nbsp;m² construídos em terreno de 592&nbsp;m², e é toda no mesmo
          andar — nenhum degrau entre a sala e o último quarto.
        </p>
        <p class="lp-hero-preco">{precoBR(d.preco)}</p>
        <p class="lp-hero-nota">
          O anúncio mostrou um pedaço. Aqui está a casa inteira, em pouco mais de
          quarenta segundos. Depois eu faço algumas perguntas e vou te mostrando o
          que interessa para o seu caso.
        </p>
        <a class="btn btn-solido lp-hero-btn" href="#etapa-moradores">Começar</a>
      </div>
    </div>
  </header>

  <!-- ————————————————— PERCURSO ————————————————— -->
  <div class="percurso">
    {ETAPAS.map((etapa, i) => (
      <section class="etapa" id={`etapa-${etapa.id}`} data-etapa={etapa.id} data-ordem={i}>
        <div class="etapa-in">
          <p class="rotulo etapa-num">{etapa.numero}</p>
          <h2>{etapa.pergunta}</h2>
          <p class="etapa-apoio">{etapa.apoio}</p>

          <div class="opcoes" role="group" aria-label={etapa.pergunta}>
            {etapa.opcoes.map((o) => (
              <button type="button" class="opcao" data-etapa={etapa.id} data-opcao={o.id}
                      data-peso={o.peso} data-fotos={o.fotos}>
                <span class="opcao-txt">{o.txt}</span>
                <span class="opcao-marca" aria-hidden="true"></span>
              </button>
            ))}
          </div>

          {etapa.opcoes.some((o) => o.eco) && (
            <div class="ecos">
              {etapa.opcoes.map((o) => o.eco && (
                <p class="eco" data-eco={`${etapa.id}:${o.id}`}>{o.eco}</p>
              ))}
            </div>
          )}

          <!-- as fotos daquela resposta chegam aqui, logo abaixo dela -->
          <div class="lp-galeria etapa-fotos" data-fotos-de={etapa.id}></div>
        </div>
      </section>
    ))}

    <!-- Acervo: as 20 fotos existem no HTML desde o carregamento, com legenda e
         alt. Com JS elas migram daqui para a etapa que as liberou; sem JS ficam
         todas aqui, e a página continua completa para leitor de tela e robô. -->
    <section class="lp-galeria-bloco" id="lp-galeria">
      <p class="rotulo lp-galeria-rot">Fotos da casa</p>
      <div class="lp-galeria" id="lp-galeria-grade">
        {minis.map((m, idx) => (
          <button type="button" class="lp-foto" data-n={idx + 1} data-i={idx}
                  aria-label={`Ampliar: ${LEGENDAS[idx]}`}>
            <img src={m.src} srcset={m.srcSet.attribute}
                 sizes="(max-width:640px) 46vw, (max-width:1000px) 30vw, 320px"
                 alt={`${LEGENDAS[idx]} — casa térrea no Morada da Colina`} loading="lazy" />
            <span class="lp-foto-leg">{LEGENDAS[idx]}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- ————————————————— FECHO ————————————————— -->
    <section class="fecho" id="fecho">
      <div class="fecho-in">
        <p class="rotulo">Para terminar</p>
        <h2 id="fecho-titulo">Me diz como te chamar</h2>
        <p class="fecho-lead" id="fecho-lead">
          Deixe seu nome e seu WhatsApp que eu te chamo para combinar o resto.
        </p>

        <aside class="resumo" id="resumo" hidden>
          <p class="rotulo">O que você me contou</p>
          <ul id="resumo-lista"></ul>
        </aside>

        <form class="form" id="form-lead" novalidate>
          <label>
            <span>Seu nome</span>
            <input type="text" name="nome" required autocomplete="name" placeholder="Como você prefere ser chamado" />
          </label>
          <label>
            <span>WhatsApp</span>
            <input type="tel" name="telefone" required autocomplete="tel" inputmode="tel" placeholder="(34) 99999-9999" />
          </label>
          <label>
            <span>E-mail <em>(opcional)</em></span>
            <input type="email" name="email" autocomplete="email" placeholder="para eu mandar a ficha completa" />
          </label>

          <button type="submit" class="btn btn-solido form-enviar">Quero falar com o Marcus</button>
          <p class="form-nota">
            Eu mesmo respondo, não é robô. Seus dados servem só para essa conversa —
            veja a <a href="/privacidade/">política de privacidade</a>.
          </p>
          <p class="form-erro" id="form-erro" hidden></p>
        </form>

        <div class="obrigado" id="obrigado" hidden>
          <h3>Recebi, obrigado.</h3>
          <p id="obrigado-txt">Vou te chamar no WhatsApp. Se preferir adiantar, é só abrir a conversa aqui.</p>
          <a class="btn-wa" id="wa-final" href="#" target="_blank" rel="noopener">Abrir conversa no WhatsApp</a>
          <p class="obrigado-ficha">
            Prefere ver tudo de uma vez? A <a href="/imovel/casa-morada-da-colina-ca5635/">ficha completa do imóvel</a> está no site.
          </p>
        </div>
      </div>
    </section>
  </div>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" hidden>
    <button class="lb-fechar" id="lb-fechar" aria-label="Fechar">✕</button>
    <button class="lb-nav lb-prev" id="lb-prev" aria-label="Foto anterior">‹</button>
    <img class="lb-img" id="lb-img" src="" alt="" />
    <button class="lb-nav lb-next" id="lb-next" aria-label="Próxima foto">›</button>
    <span class="lb-contador" id="lb-contador"></span>
  </div>

  <script
    is:inline
    define:vars={{
      dados: dadosJs,
      urls: grandes.map((g) => g.src),
      legendas: LEGENDAS,
      titulo: d.titulo,
    }}
  >
    (function () {
      var html = document.documentElement;
      var etapas = Array.from(document.querySelectorAll('.etapa'));
      var grade = document.getElementById('lp-galeria-grade');
      var fotos = Array.from(grade.querySelectorAll('.lp-foto'));
      var barra = document.getElementById('barra');
      var suave = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      var respostas = {};
      var score = 0;
      var liberadas = 0;
      var sequencia = dados.sequencias.andar;

      /* ——— fotos ———
         Cada resposta entrega as próximas fotos da sequência dentro da própria
         etapa, para o visitante ver o resultado onde ele está, e não no fim da
         página. Mover o nó preserva a imagem já carregada. */
      function revela(qtd, destino) {
        var de = liberadas;
        liberadas = Math.min(fotos.length, liberadas + qtd);
        sequencia.slice(de, liberadas).forEach(function (n, pos) {
          var el = fotos[n - 1];
          if (!el) return;
          destino.appendChild(el);
          el.style.transitionDelay = suave ? pos * 80 + 'ms' : '0ms';
          /* reflow síncrono para a transição pegar o estado inicial.
             requestAnimationFrame não serve: em aba oculta ele não dispara e
             as fotos ficariam invisíveis para sempre. */
          void el.offsetWidth;
          el.classList.add('vista');
        });
        destino.classList.add('cheia');
      }
      /* Trocar a resposta da pergunta 2 muda o eixo: as fotos já entregues são
         devolvidas e reentregues na ordem nova, sem repetir nem sumir. */
      function refazEntrega() {
        var total = liberadas;
        fotos.forEach(function (f) {
          f.classList.remove('vista');
          f.style.transitionDelay = '0ms';
          f.style.transition = 'none';
          grade.appendChild(f);
          void f.offsetWidth;
          f.style.transition = '';
        });
        liberadas = 0;
        var acumulado = 0;
        dados.etapas.forEach(function (e) {
          var r = respostas[e.id];
          if (!r || acumulado >= total) return;
          var caixa = document.querySelector('[data-fotos-de="' + e.id + '"]');
          var quanto = Math.min(r.fotos, total - acumulado);
          acumulado += quanto;
          revela(quanto, caixa);
        });
      }

      /* ——— avanço ——— */
      function destrava(i) {
        var alvo = etapas[i];
        if (!alvo) return;
        alvo.classList.add('aberta');
      }
      function rolaAte(el) {
        if (!el) return;
        el.scrollIntoView({ behavior: suave ? 'smooth' : 'auto', block: 'center' });
      }
      function atualizaBarra() {
        var feitas = Object.keys(respostas).length;
        barra.style.width = (feitas / dados.etapas.length) * 100 + '%';
      }

      etapas.forEach(function (secao, i) {
        secao.querySelectorAll('.opcao').forEach(function (botao) {
          botao.addEventListener('click', function () {
            var idEtapa = botao.dataset.etapa;
            var idOpcao = botao.dataset.opcao;
            var jaRespondida = !!respostas[idEtapa];

            /* trocar de resposta não soma pontos nem fotos de novo */
            if (jaRespondida) {
              score -= respostas[idEtapa].peso;
            }
            respostas[idEtapa] = {
              opcao: idOpcao,
              texto: botao.querySelector('.opcao-txt').textContent,
              peso: Number(botao.dataset.peso),
              fotos: Number(botao.dataset.fotos),
            };
            score += Number(botao.dataset.peso);

            secao.querySelectorAll('.opcao').forEach(function (b) {
              b.classList.toggle('escolhida', b === botao);
              b.setAttribute('aria-pressed', b === botao ? 'true' : 'false');
            });
            secao.classList.add('respondida');

            var eco = secao.querySelector('[data-eco="' + idEtapa + ':' + idOpcao + '"]');
            secao.querySelectorAll('.eco').forEach(function (p) { p.classList.remove('visivel'); });
            if (eco) eco.classList.add('visivel');

            /* A pergunta 2 troca o eixo, então a sequência inteira muda: as
               fotos já entregues precisam ser redistribuídas na ordem nova,
               senão uma foto da ordem antiga migra e abre buraco atrás. */
            if (idEtapa === 'pesa') {
              sequencia = dados.sequencias[idOpcao] || sequencia;
              refazEntrega();
            }

            if (!jaRespondida) {
              revela(
                Number(botao.dataset.fotos),
                secao.querySelector('[data-fotos-de="' + idEtapa + '"]')
              );
            }
            atualizaBarra();

            if (i + 1 < etapas.length) {
              destrava(i + 1);
              if (!jaRespondida) setTimeout(function () { rolaAte(etapas[i + 1]); }, 420);
            } else {
              fecha();
            }
          });
        });
      });

      /* ——— fecho: o tom muda com a temperatura ——— */
      function fecha() {
        var sec = document.getElementById('fecho');
        sec.classList.add('aberta');

        var titulo = document.getElementById('fecho-titulo');
        var lead = document.getElementById('fecho-lead');
        var quer = respostas.visita && respostas.visita.opcao;

        if (score >= 70 || quer === 'semana') {
          titulo.textContent = 'Então vamos marcar';
          lead.textContent =
            'Pelo que você me contou, faz sentido conhecer a casa logo. Deixa seu nome e seu WhatsApp que eu te chamo para combinar dia e horário.';
        } else if (score >= 40) {
          titulo.textContent = 'Me diz como te chamar';
          lead.textContent =
            'Deixa seu nome e seu WhatsApp. Eu te mando a ficha completa e a gente combina a visita quando fizer sentido para você.';
        } else {
          titulo.textContent = 'Sem pressa nenhuma';
          lead.textContent =
            'Se ainda está pesquisando, tudo bem — no seu lugar eu faria igual. Deixa seu contato que eu te mando a ficha completa e aviso quando aparecer algo parecido.';
        }

        var lista = document.getElementById('resumo-lista');
        lista.innerHTML = '';
        dados.etapas.forEach(function (e) {
          var r = respostas[e.id];
          if (!r) return;
          var li = document.createElement('li');
          li.textContent = r.texto;
          lista.appendChild(li);
        });
        document.getElementById('resumo').hidden = false;

        setTimeout(function () { rolaAte(sec); }, 420);
      }

      /* ——— envio ——— */
      function resumoTexto() {
        var partes = [];
        dados.etapas.forEach(function (e) {
          var r = respostas[e.id];
          if (r) partes.push('• ' + r.texto);
        });
        return partes.join('\n');
      }

      var form = document.getElementById('form-lead');
      form.addEventListener('submit', function (ev) {
        ev.preventDefault();
        var erro = document.getElementById('form-erro');
        var dadosForm = new FormData(form);
        var nome = (dadosForm.get('nome') || '').toString().trim();
        var telefone = (dadosForm.get('telefone') || '').toString().trim();
        var email = (dadosForm.get('email') || '').toString().trim();

        if (!nome || telefone.replace(/\D/g, '').length < 10) {
          erro.textContent = 'Preciso do seu nome e de um WhatsApp com DDD.';
          erro.hidden = false;
          return;
        }
        erro.hidden = true;

        var botao = form.querySelector('.form-enviar');
        botao.disabled = true;
        botao.textContent = 'Enviando…';

        var eventId = 'lp-ca5635-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
        var corpo = {
          nome: nome, telefone: telefone, email: email,
          imovel: 'CA5635 — Casa térrea de 4 suítes no Morada da Colina',
          score: score,
          respostas: dados.etapas.map(function (e) {
            var r = respostas[e.id];
            return r ? { pergunta: e.id, resposta: r.texto } : null;
          }).filter(Boolean),
        };

        fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(corpo),
        })
          .catch(function () { /* o WhatsApp abaixo continua sendo o caminho */ })
          .then(function () {
            if (window.fbq) fbq('track', 'Lead', { content_name: 'CA5635' }, { eventID: eventId });
            fetch('/api/capi', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                event_name: 'Lead',
                event_id: eventId,
                event_source_url: window.location.href,
                contato: { email: email || undefined, telefone: telefone },
              }),
            }).catch(function () {});

            form.hidden = true;
            var ok = document.getElementById('obrigado');
            ok.hidden = false;
            document.getElementById('obrigado-txt').textContent =
              'Oi ' + nome.split(' ')[0] + ', recebi seu contato. Vou te chamar no WhatsApp. Se preferir adiantar, é só abrir a conversa aqui.';
            var msg =
              'Olá Marcus, sou ' + nome + '. Vim pela página da casa térrea no Morada da Colina (CA5635).\n\n' +
              resumoTexto();
            document.getElementById('wa-final').href =
              'https://wa.me/' + dados.wa + '?text=' + encodeURIComponent(msg);
            rolaAte(ok);
          });
      });

      /* ——— lightbox ——— */
      var lb = document.getElementById('lightbox');
      var lbImg = document.getElementById('lb-img');
      var contador = document.getElementById('lb-contador');
      var idx = 0;
      function visiveis() {
        return sequencia.slice(0, Math.max(liberadas, html.classList.contains('js') ? 0 : fotos.length));
      }
      function mostra(i) {
        var lista = visiveis();
        if (!lista.length) return;
        idx = (i + lista.length) % lista.length;
        var n = lista[idx];
        lbImg.src = urls[n - 1];
        lbImg.alt = legendas[n - 1] + ' — ' + titulo;
        contador.textContent = idx + 1 + ' / ' + lista.length;
      }
      function abre(n) {
        var lista = visiveis();
        var pos = lista.indexOf(n);
        mostra(pos < 0 ? 0 : pos);
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function fechaLb() { lb.hidden = true; document.body.style.overflow = ''; }
      fotos.forEach(function (f) {
        f.addEventListener('click', function () { abre(Number(f.dataset.n)); });
      });
      document.getElementById('lb-fechar').addEventListener('click', fechaLb);
      document.getElementById('lb-prev').addEventListener('click', function () { mostra(idx - 1); });
      document.getElementById('lb-next').addEventListener('click', function () { mostra(idx + 1); });
      lb.addEventListener('click', function (e) { if (e.target === lb) fechaLb(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') fechaLb();
        if (e.key === 'ArrowLeft') mostra(idx - 1);
        if (e.key === 'ArrowRight') mostra(idx + 1);
      });

      /* ——— estado inicial ——— */
      destrava(0);
    })();
  </script>

  <style>
    /* ——— barra de progresso ——— */
    .lp-progresso {
      position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 40;
      background: color-mix(in srgb, var(--tinta) 10%, transparent);
    }
    .lp-progresso span {
      display: block; height: 100%; width: 0;
      background: var(--ciano); transition: width .5s cubic-bezier(.2,.7,.3,1);
    }

    /* ——— abertura ——— */
    .lp-hero { padding: 56px 0 28px; }
    .lp-hero-in {
      max-width: var(--maxw); margin: 0 auto; padding: 0 28px;
      display: grid; gap: 40px; align-items: center;
      grid-template-columns: 1fr;
    }
    .lp-hero-rot { color: var(--ciano-tinta); margin: 0 0 14px; }
    .lp-hero h1 {
      font-family: var(--display); font-size: clamp(2rem, 6.4vw, 3.4rem);
      line-height: 1.03; letter-spacing: -.028em; margin: 0 0 4px;
    }
    .lp-hero-lead { font-size: 1.12rem; margin: 0 0 22px; max-width: 40ch; }
    .lp-hero-preco {
      font-family: var(--display); font-weight: 600;
      font-size: clamp(1.5rem, 4.4vw, 2rem); letter-spacing: -.02em; margin: 0 0 20px;
    }
    .lp-hero-nota { color: var(--tinta-media); max-width: 44ch; margin: 0 0 28px; }
    .lp-hero-btn { display: inline-block; }

    .lp-hero-video { margin: 18px 0 26px; }
    .lp-hero-video video {
      width: 100%; max-width: 420px; aspect-ratio: 9 / 16; height: auto;
      display: block; border-radius: 14px; background: var(--papel-fundo);
      box-shadow: var(--sombra-alta); object-fit: cover;
    }
    .lp-hero-video figcaption { margin-top: 12px; color: var(--tinta-fraca); }

    /* No telefone a ordem é a do HTML: título, vídeo, texto. O vídeo é o
       gancho — ele não pode ficar embaixo de três parágrafos. */
    @media (min-width: 900px) {
      .lp-hero { padding: 84px 0 40px; }
      .lp-hero-in {
        grid-template-columns: 1.05fr .95fr;
        grid-template-areas: 'topo video' 'texto video';
        /* a segunda linha absorve a altura do vídeo; sem isso as duas linhas
           dividem essa altura e abre um vão entre o título e o texto */
        grid-template-rows: auto 1fr;
        gap: 18px 64px; align-items: start;
      }
      .lp-hero-topo { grid-area: topo; }
      .lp-hero-texto { grid-area: texto; }
      .lp-hero-video { grid-area: video; justify-self: end; align-self: center; }
    }

    /* ——— etapas ——— */
    .percurso { max-width: 780px; margin: 0 auto; padding: 0 28px 96px; }
    .etapa { padding: 44px 0; border-top: 1px solid var(--traco); }
    .etapa-num { color: var(--ciano-tinta); margin: 0 0 12px; }
    .etapa h2 {
      font-family: var(--display); font-size: clamp(1.45rem, 4.4vw, 2.05rem);
      line-height: 1.1; letter-spacing: -.022em; margin: 0 0 10px;
    }
    .etapa-apoio { color: var(--tinta-media); margin: 0 0 26px; }

    .opcoes { display: grid; gap: 12px; }
    .opcao {
      display: flex; align-items: center; gap: 14px; width: 100%;
      text-align: left; font: inherit; color: inherit; cursor: pointer;
      background: var(--papel-alto); border: 1px solid var(--traco);
      border-radius: 12px; padding: 17px 19px;
      transition: border-color .2s, background .2s, transform .2s, box-shadow .2s;
    }
    .opcao:hover { border-color: var(--traco-forte); transform: translateY(-1px); box-shadow: var(--sombra); }
    .opcao-txt { flex: 1; }
    .opcao-marca {
      flex: none; width: 21px; height: 21px; border-radius: 50%;
      border: 2px solid var(--traco-forte); position: relative; transition: all .2s;
    }
    .opcao.escolhida { border-color: var(--ciano); background: color-mix(in srgb, var(--ciano) 7%, var(--papel-alto)); }
    .opcao.escolhida .opcao-marca { border-color: var(--ciano); background: var(--ciano); }
    .opcao.escolhida .opcao-marca::after {
      content: ''; position: absolute; inset: 0; margin: auto;
      width: 6px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0;
      transform: rotate(45deg) translate(-1px, -1px);
    }
    .etapa.respondida .opcao:not(.escolhida) { opacity: .5; }

    .ecos { margin-top: 22px; }
    .eco {
      display: none; margin: 0; padding: 16px 18px;
      background: color-mix(in srgb, var(--ciano) 6%, transparent);
      border-left: 3px solid var(--ciano); border-radius: 0 10px 10px 0;
      color: var(--tinta-media);
    }
    .eco.visivel { display: block; animation: sobe .45s cubic-bezier(.2,.7,.3,1) both; }

    /* ——— galeria ——— */
    .lp-galeria-bloco { padding: 40px 0; border-top: 1px solid var(--traco); }
    .lp-galeria-rot { color: var(--ciano-tinta); margin: 0 0 18px; }
    .lp-galeria { display: flex; flex-wrap: wrap; gap: 10px; }
    .etapa-fotos:empty { display: none; }
    .etapa-fotos.cheia { margin-top: 22px; }
    .lp-foto {
      flex: 1 1 calc(50% - 5px); min-width: 140px; position: relative;
      padding: 0; border: 0; background: var(--papel-fundo); cursor: pointer;
      border-radius: 10px; overflow: hidden; aspect-ratio: 4 / 3;
    }
    .lp-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .lp-foto-leg {
      position: absolute; inset: auto 0 0 0; padding: 26px 10px 8px;
      font-family: var(--mono); font-size: .62rem; letter-spacing: .01em;
      line-height: 1.3; text-transform: uppercase; color: #fff; text-align: left;
      background: linear-gradient(to top, rgba(10,16,28,.85), transparent);
    }
    @media (min-width: 640px) { .lp-foto { flex-basis: calc(33.333% - 7px); } }

    /* ——— fecho ——— */
    .fecho { padding: 48px 0 0; border-top: 1px solid var(--traco); }
    .fecho h2 {
      font-family: var(--display); font-size: clamp(1.5rem, 4.6vw, 2.15rem);
      line-height: 1.08; letter-spacing: -.022em; margin: 10px 0 12px;
    }
    .fecho-lead { margin: 0 0 26px; max-width: 46ch; }
    .resumo {
      background: var(--papel-alto); border: 1px solid var(--traco);
      border-radius: 12px; padding: 18px 20px; margin: 0 0 26px;
    }
    .resumo .rotulo { color: var(--ciano-tinta); }
    .resumo ul { margin: 10px 0 0; padding-left: 18px; color: var(--tinta-media); }
    .resumo li { margin: 4px 0; }

    .form { display: grid; gap: 14px; max-width: 460px; }
    .form label { display: grid; gap: 6px; }
    .form label span {
      font-family: var(--mono); font-size: .74rem; letter-spacing: .06em;
      text-transform: uppercase; color: var(--tinta-media);
    }
    .form label em { font-style: normal; opacity: .7; text-transform: none; letter-spacing: 0; }
    .form input {
      font: inherit; color: inherit; background: var(--papel-alto);
      border: 1px solid var(--traco); border-radius: 10px; padding: 13px 15px;
      transition: border-color .2s;
    }
    .form input:focus { border-color: var(--ciano); outline: none; }
    .form-enviar { margin-top: 6px; border: 0; cursor: pointer; font: inherit; }
    .form-enviar[disabled] { opacity: .6; cursor: default; }
    .form-nota { font-size: .86rem; color: var(--tinta-fraca); margin: 0; }
    .form-nota a { text-decoration: underline; }
    .form-erro { color: #b3261e; margin: 0; font-size: .92rem; }

    .obrigado h3 { font-family: var(--display); font-size: 1.5rem; margin: 0 0 10px; }
    .obrigado p { margin: 0 0 18px; }
    .obrigado-ficha { font-size: .92rem; color: var(--tinta-fraca); margin-top: 20px; }
    .obrigado-ficha a { text-decoration: underline; }

    /* ——— animação de entrada ———
       Só existe quando o JS está vivo. Sem JS, tudo já está aberto e legível. */
    @keyframes sobe {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: none; }
    }
    :global(html.js) .etapa,
    :global(html.js) .fecho {
      opacity: 0; transform: translateY(22px); pointer-events: none;
      transition: opacity .55s cubic-bezier(.2,.7,.3,1), transform .55s cubic-bezier(.2,.7,.3,1);
    }
    :global(html.js) .etapa.aberta,
    :global(html.js) .fecho.aberta {
      opacity: 1; transform: none; pointer-events: auto;
    }
    /* Com JS o acervo do fim vira só a origem das fotos: elas migram para a
       etapa que as liberou, e o bloco não aparece. */
    :global(html.js) .lp-galeria-bloco { display: none; }
    :global(html.js) .lp-foto {
      opacity: 0; transform: scale(.94) translateY(10px);
      transition: opacity .55s ease, transform .55s cubic-bezier(.2,.7,.3,1);
    }
    :global(html.js) .lp-foto.vista { opacity: 1; transform: none; }

    @media (prefers-reduced-motion: reduce) {
      :global(html.js) .etapa,
      :global(html.js) .fecho,
      :global(html.js) .lp-foto { transition: none; }
      .eco.visivel { animation: none; }
    }
  </style>
</LP>
