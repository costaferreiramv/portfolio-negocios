---
/* Landing page do lançamento Loren Residence (Altamira, Uberlândia).
   Rolagem única, sem menu: o conteúdo se apresenta na ordem do book
   (conceito, projeto, localização, lazer, decorado, plantas, ficha) e fecha em
   dois botões de WhatsApp. Estética do book: marinho, ocre, creme, aquarela
   turquesa; fontes STIX Two Text (serifada) e Inter, as mesmas do material.
   Imagens e plantas vêm do book e do caderno de plantas (ver public/loren);
   as fotos e o vídeo são do apartamento decorado. */
import '@fontsource/stix-two-text/400.css';
import '@fontsource/stix-two-text/400-italic.css';
import '@fontsource/stix-two-text/600.css';
import '@fontsource-variable/inter';
import LP from '../layouts/LP.astro';
import { waLink } from '../lib/site';
import assets from '../data/loren-assets.json';

const R = assets.render as Record<string, [number, number]>;
const F = assets.foto as Record<string, [number, number]>;
const D = '/loren/';

/** Render do book: src grande + 800 px quando existe. */
const SEM_PEQUENA = new Set(['pilotis', 'creditos', 'folha']);
function r(nome: string, alt: string) {
  const [w, h] = R[nome];
  const pequena = w > 900 && !SEM_PEQUENA.has(nome) && !nome.startsWith('planta-');
  return {
    src: `${D}${nome}.webp`,
    srcset: pequena ? `${D}${nome}-800.webp 800w, ${D}${nome}.webp ${w}w` : undefined,
    w, h, alt,
  };
}
function f(n: string, alt: string) {
  const [w, h] = F[n];
  return {
    src: `${D}dec-${n}.webp`,
    srcset: `${D}dec-${n}-800.webp ${Math.round(800 * (w >= h ? 1 : w / h))}w, ${D}dec-${n}.webp ${w}w`,
    w, h, alt, n,
  };
}

const URL_PAGINA = new URL('/loren/', Astro.site).href;
const MSG_AGENDAR =
