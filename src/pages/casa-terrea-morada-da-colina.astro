---
/* Landing page de funil do CA5635 — casa térrea de 4 suítes no Morada da Colina.
   Fluxo tipo assistente: uma pergunta por vez, com "voltar" e "avançar" —
   nada acontece sozinho no tempo, é sempre o clique do visitante que muda de
   tela. Cada pergunta já mostra suas fotos ao abrir; responder só soma o
   comentário do Marcus, sem trocar o que já está na tela. O canonical aponta
   para a ficha, que continua sendo a página oficial do imóvel — a LP não
   disputa busca com ela. */
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import LP from '../layouts/LP.astro';
import { fotosDe, precoBR } from '../lib/fotos';
import { CONTATO } from '../lib/site';

const imoveis = await getCollection('imoveis');
const imovel = imoveis.find((i) => i.data.codigo === 'CA5635')!;
const d = imovel.data;
const fotos = fotosDe(d.fotos, d.capa);

/* fotosDe() devolve a capa primeiro; aqui a ordem tem de ser a do arquivo,
   porque as listas abaixo se referem ao número do arquivo (foto-N.jpg). */
const emOrdem = fotosDe(d.fotos);
const minis = await Promise.all(
  emOrdem.map((f) => getImage({ src: f, width: 800, widths: [420, 800], format: 'webp' }))
);
const grandes = await Promise.all(
  emOrdem.map((f) => getImage({ src: f, width: 1600, format: 'webp' }))
);
const ogJpg = await getImage({ src: fotos[0], width: 1200, format: 'jpg' });

/* Legendas conferidas foto a foto contra o acervo. Nada aqui é suposição:
   o que não dá para afirmar da imagem ficou em termo neutro. */
const LEGENDAS = [
  'Sala com saída para o jardim',
  'Salão com churrasqueira',
  'Sala em três ambientes',
  'Jantar com pendente',
  'Estar com porta de vidro',
  'Sala',
  'Espaço gourmet',
  'Corredor das suítes',
  'Suíte com saída ao jardim',
  'Suíte com armário',
  'Armários planejados',
  'Suíte ampla',
  'Sala com bancada',
  'Cozinha com marcenaria',
  'Área externa lateral',
  'Piscina',
  'Pergolado',
  'Banheiro de suíte',
  'Banheiro',
  'Banheiro de suíte',
];

/* Seis perguntas, uma por vez. As fotos (quando existem) são fixas da
   pergunta e aparecem já ao abrir, antes de qualquer clique — não dependem
   de qual opção o visitante escolhe. O eco é o comentário que aparece depois
   da escolha. Só a pergunta 6 carrega fecho (título e texto do fim). */
const ETAPAS = [
  {
    id: 'moradores',
    pergunta: 'Quem vai morar na casa?',
    apoio: 'Entender sua família desde já faz toda a diferença.',
    fotos: [10, 11, 9, 12, 3, 4, 16, 7],
    opcoes: [
      { id: 'filhos', txt: 'Família com filhos em casa',
        eco: 'A casa oferece 4 suítes amplas, todas montadas com planejados e espaço externo de sobra.' },
      { id: 'casal', txt: 'Casal, com quartos para receber',
        eco: 'Dá pra receber muito bem os familiares e amigos de fora, com conforto, privacidade e acessibilidade.' },
      { id: 'tresgeracoes', txt: 'Família grande, com pais ou sogros junto',
        eco: 'A acessibilidade é fundamental. A casa possui alguns desníveis decorativos — você precisa ver isso pessoalmente e avaliar.' },
      { id: 'recebe', txt: 'Somos poucos, mas recebemos muito',
        eco: 'Então o importante pode ser o que fica em volta da casa. Além da piscina, a casa tem um gourmet bem espaçoso para acolher os eventos familiares.' },
    ],
  },
  {
    id: 'pesa',
    pergunta: 'O que mais pesa na sua escolha?',
    apoio: 'Escolha o que você olharia primeiro numa visita.',
    fotos: [1, 6, 18, 17, 2, 19, 14, 13, 20, 5, 8, 15],
    opcoes: [
      { id: 'andar', txt: 'Ser tudo no mesmo andar, sem escada',
        eco: 'Então vou começar por dentro. São 284 m² construídos e nenhum degrau entre a sala e o último quarto.' },
      { id: 'receber', txt: 'Ter espaço para receber',
        eco: 'Então vou começar pela área de lazer: piscina aquecida, churrasqueira e pergolado.' },
      { id: 'conservacao', txt: 'As condições de conservação da casa',
        eco: 'Você vai perceber que a casa foi muito bem cuidada — acabamento, marcenaria e estrutura em ótimo estado.' },
      { id: 'comodos', txt: 'O espaço dos cômodos',
        eco: 'Os ambientes são generosos, nada de cômodo apertado aqui. Vou te mostrar a sala e os espaços internos.' },
    ],
  },
  {
    id: 'prazo',
    pergunta: 'Em quanto tempo você pretende resolver este negócio?',
    apoio: 'Nada mais justo que um alinhamento de expectativas entre as partes.',
    opcoes: [
      { id: 'ate3', txt: 'Até 3 meses', peso: 25 },
      { id: '3a6', txt: 'De 3 a 6 meses', peso: 18 },
      { id: 'ano', txt: 'Ainda este ano', peso: 10 },
      { id: 'pesquisa', txt: 'Sem prazo, estou pesquisando', peso: 3 },
    ],
  },
  {
    id: 'venda',
    pergunta: 'Você tem intenção de colocar um imóvel para realizar o negócio?',
    apoio: 'Aqui é onde todos ganham tempo na negociação. Uma informação que preciso apresentar para o proprietário antes de agendar qualquer visita.',
    fotos: [12, 9, 4, 6, 7, 16],
    opcoes: [
      { id: 'permuta', txt: 'Sim, preciso saber se o vendedor aceita permuta',
        eco: 'Certo! Vou pegar os detalhes com você para validar a possibilidade com o vendedor.' },
      { id: 'aindanao', txt: 'Não, mas preciso vender o meu primeiro',
        eco: 'Vale conversarmos sobre isso: anunciar no preço certo costuma encurtar bastante o caminho.' },
      { id: 'direta', txt: 'Não, é compra direta',
        eco: 'Então o processo é bem mais simples: depende só da sua decisão.' },
    ],
  },
  {
    id: 'pagamento',
    pergunta: 'Como você pretende pagar?',
    apoio: 'Financiamento bancário, carta de consórcio ou recurso próprio.',
    fotos: [10, 3, 13, 17, 14, 20, 5, 8],
    opcoes: [
      { id: 'avista', txt: 'À vista', eco: 'Certo.' },
      { id: 'misto', txt: 'Parte à vista, parte financiada', eco: 'Anotado.' },
      { id: 'banco', txt: 'Financiamento bancário já aprovado / Carta de crédito contemplada', eco: 'Excelente.' },
      { id: 'avaliando', txt: 'Ainda estou avaliando',
        eco: 'Tranquilo. Importante consultar um correspondente bancário pra te auxiliar nesta avaliação.' },
    ],
  },
  {
    id: 'visita',
    pergunta: 'Você gostaria de conhecer a casa pessoalmente?',
    apoio: 'Foto e vídeo mostram muito, mas o tamanho e a energia da casa a gente só sente entrando, né?',
    opcoes: [
      { id: 'semana', txt: 'Quero marcar esta semana',
        fechoTitulo: 'Excelente!',
        fechoLead: 'Pelo que você contou, faz sentido mesmo conhecer a casa logo. Deixa seu nome e seu WhatsApp que eu te chamo para pegar sua disponibilidade.' },
      { id: 'depois', txt: 'Quero, mas mais para frente',
        fechoTitulo: 'Sem problemas!',
        fechoLead: 'Provavelmente ainda tem alguma dúvida pra sanarmos. Vamos conversar no WhatsApp ou no telefone, se estiver mais tranquilo, e aí depois de tudo certo marcamos a visita, se ainda for sua intenção. Deixa seu nome e seu número que eu te chamo em breve.' },
      { id: 'infoantes', txt: 'Prefiro receber mais informações antes',
        fechoTitulo: 'Claro! Tudo no seu tempo.',
        fechoLead: 'Deixa seu nome e seu WhatsApp. Eu te mando a ficha completa da casa e a gente conversa pra eu entender suas dúvidas.' },
    ],
  },
];

const canonicalFicha = new URL('/imovel/casa-morada-da-colina-ca5635/', Astro.site).href;
const urlLp = new URL('/casa-terrea-morada-da-colina/', Astro.site).href;
const descricao =
  'Casa térrea à venda no Morada da Colina, Uberlândia — 284 m² construídos em terreno de esquina com 592 m², 4 suítes com planejados, piscina e 3 vagas. Veja o vídeo da casa inteira e fale direto com o corretor.';

const videoLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Casa térrea de 4 suítes no Morada da Colina — vídeo da casa inteira',
  description:
    'Percurso completo pela casa térrea de 284 m² no Morada da Colina, Uberlândia: sala em três ambientes, cozinha, as quatro suítes, piscina aquecida e área externa.',
  thumbnailUrl: [new URL('/video/ca5635-tour-poster.jpg', Astro.site).href],
  contentUrl: new URL('/video/ca5635-tour.mp4', Astro.site).href,
  uploadDate: '2026-08-12',
  duration: 'PT41S',
};
const listingLd = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: d.titulo,
  description: descricao,
  url: canonicalFicha,
  mainEntityOfPage: urlLp,
  image: grandes.map((g) => new URL(g.src, Astro.site).href),
  numberOfRooms: d.dormitorios,
  floorSize: { '@type': 'QuantitativeValue', value: d.areaUtil, unitCode: 'MTK' },
  offers: {
    '@type': 'Offer', price: d.preco, priceCurrency: 'BRL',
    availability: 'https://schema.org/InStock', url: canonicalFicha,
  },
  address: {
    '@type': 'PostalAddress', addressLocality: 'Uberlândia',
    addressRegion: 'MG', addressCountry: 'BR',
  },
};

const dadosJs = {
  etapas: ETAPAS.map((e) => ({ id: e.id })),
  wa: CONTATO.whatsappNum,
};
---

<LP
  title="Casa térrea de 4 suítes no Morada da Colina, Uberlândia | Portfólio Negócios"
  description={descricao}
  image={ogJpg.src}
  canonical={canonicalFicha}
  jsonLd={[listingLd, videoLd]}
>
  <div class="lp-progresso" aria-hidden="true"><span id="barra"></span></div>

  <!-- ————————————————— ABERTURA ————————————————— -->
  <header class="lp-hero">
    <div class="lp-hero-in">
      <div class="lp-hero-topo">
        <p class="rotulo lp-hero-rot">Morada da Colina · Uberlândia · Ref. {d.codigo}</p>
        <h1>Casa térrea com 4&nbsp;suítes no Morada da Colina</h1>
      </div>

      <figure class="lp-hero-video">
        <video
          id="video-tour"
          src="/video/ca5635-tour.mp4"
          poster="/video/ca5635-tour-poster.jpg"
          playsinline muted loop autoplay controls preload="metadata"
          aria-label="Vídeo do percurso completo pela casa"
        ></video>
      </figure>

      <div class="lp-hero-texto">
        <p class="lp-hero-lead">
          Você que procura por casa térrea grande, na Zona Sul, fora de condomínio,
          sabe como é difícil aparecer uma que realmente esteja boa. Esta tem
          284&nbsp;m² construídos em um terreno de esquina com 592&nbsp;m², um
          projeto atemporal bem distribuído, com espaços de área íntima e social
          bem colocados, proporcionando o melhor em privacidade e lazer.
        </p>
        <p class="lp-hero-preco">{precoBR(d.preco)} <span>(somente venda)</span></p>
        <p class="lp-hero-nota">
          O anúncio te mostrou um pedaço. Aqui estão os detalhes, a casa inteira,
          em pouco mais de quarenta segundos. Depois quero entender melhor suas
          expectativas e prioridades para, se for o seu desejo para o momento,
          lhe proporcionar o atendimento mais assertivo possível.
        </p>
        <button type="button" class="btn btn-solido lp-hero-btn" id="btn-comecar">Começar</button>
      </div>
    </div>
  </header>

  <!-- ————————————————— PERCURSO: uma pergunta por vez ————————————————— -->
  <div class="percurso" id="percurso">
    {ETAPAS.map((etapa, i) => (
      <section class="etapa" id={`etapa-${etapa.id}`} data-etapa={etapa.id} data-ordem={i}>
        <div class="etapa-in">
          {i > 0 && <button type="button" class="voltar" data-voltar={i}>← voltar</button>}
          <h2>{etapa.pergunta}</h2>
          <p class="etapa-apoio">{etapa.apoio}</p>

          {etapa.fotos && (
            <div class="lp-galeria etapa-fotos">
              {etapa.fotos.map((n) => (
                <button type="button" class="lp-foto" data-n={n}
                        aria-label={`Ampliar: ${LEGENDAS[n - 1]}`}>
                  <img src={minis[n - 1].src} srcset={minis[n - 1].srcSet.attribute}
                       sizes="(max-width:640px) 46vw, (max-width:1000px) 30vw, 320px"
                       alt={`${LEGENDAS[n - 1]} — casa térrea no Morada da Colina`} loading="lazy" />
                  <span class="lp-foto-leg">{LEGENDAS[n - 1]}</span>
                </button>
              ))}
            </div>
          )}

          <div class="opcoes" role="group" aria-label={etapa.pergunta}>
            {etapa.opcoes.map((o) => (
              <button type="button" class="opcao" data-etapa={etapa.id} data-opcao={o.id}
                      data-peso={o.peso || 0}
                      data-fecho-titulo={o.fechoTitulo} data-fecho-lead={o.fechoLead}>
                <span class="opcao-txt">{o.txt}</span>
                <span class="opcao-marca" aria-hidden="true"></span>
              </button>
            ))}
          </div>

          {etapa.opcoes.some((o) => o.eco) && (
            <div class="ecos">
              {etapa.opcoes.map((o) => o.eco && (
                <p class="eco" data-eco={`${etapa.id}:${o.id}`}>{o.eco}</p>
              ))}
            </div>
          )}

          <button type="button" class="avancar" hidden>
            {i + 1 < ETAPAS.length ? 'Avançar →' : 'Continuar →'}
          </button>
        </div>
      </section>
    ))}

    <!-- Acervo completo: as 20 fotos com legenda e alt, sempre no HTML — cobre
         o que não aparece em nenhuma pergunta específica e serve de fallback
         completo para quem navega sem JavaScript. -->
    <section class="lp-galeria-bloco" id="lp-galeria">
      <p class="rotulo lp-galeria-rot">Todas as fotos da casa</p>
      <div class="lp-galeria" id="lp-galeria-grade">
        {minis.map((m, idx) => (
          <button type="button" class="lp-foto" data-n={idx + 1}
                  aria-label={`Ampliar: ${LEGENDAS[idx]}`}>
            <img src={m.src} srcset={m.srcSet.attribute}
                 sizes="(max-width:640px) 46vw, (max-width:1000px) 30vw, 320px"
                 alt={`${LEGENDAS[idx]} — casa térrea no Morada da Colina`} loading="lazy" />
            <span class="lp-foto-leg">{LEGENDAS[idx]}</span>
          </button>
        ))}
      </div>
    </section>

    <!-- ————————————————— FECHO ————————————————— -->
    <section class="fecho" id="fecho">
      <div class="fecho-in">
        <button type="button" class="voltar" id="fecho-voltar">← voltar</button>
        <h2 id="fecho-titulo">Me diz como te chamar</h2>
        <p class="fecho-lead" id="fecho-lead">
          Deixe seu nome e seu WhatsApp que eu te chamo para combinar o resto.
        </p>

        <aside class="resumo" id="resumo" hidden>
          <p class="rotulo">O que você já me contou</p>
          <ul id="resumo-lista"></ul>
        </aside>

        <form class="form" id="form-lead" novalidate>
          <label>
            <span>Seu nome</span>
            <input type="text" name="nome" required autocomplete="name" placeholder="Como você prefere ser chamado" />
          </label>
          <label>
            <span>WhatsApp</span>
            <input type="tel" name="telefone" required autocomplete="tel" inputmode="tel" placeholder="(34) 99999-9999" />
          </label>
          <label>
            <span>E-mail <em>(opcional)</em></span>
            <input type="email" name="email" autocomplete="email" placeholder="para eu mandar a ficha completa" />
          </label>

          <div class="fecho-botoes">
            <button type="button" class="btn btn-solido" id="btn-enviar">Enviar mensagem</button>
            <button type="button" class="btn-wa" id="btn-whats" hidden>Falar no WhatsApp agora</button>
          </div>
          <p class="form-nota">
            Seus dados servem só para essa conversa — veja a <a href="/privacidade/">política de privacidade</a>.
          </p>
          <p class="form-erro" id="form-erro" hidden></p>
        </form>
      </div>
    </section>
  </div>

  <!-- ————————————————— AGRADECIMENTO: tela cheia ————————————————— -->
  <div class="obrigado" id="obrigado" hidden>
    <p class="obrigado-sub">Será uma satisfação atender você!</p>
    <p class="obrigado-grande">Gratidão!</p>
    <a class="btn-wa" id="wa-final" href="#" target="_blank" rel="noopener">Abrir conversa no WhatsApp</a>
  </div>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" hidden>
    <button class="lb-fechar" id="lb-fechar" aria-label="Fechar">✕</button>
    <button class="lb-nav lb-prev" id="lb-prev" aria-label="Foto anterior">‹</button>
    <img class="lb-img" id="lb-img" src="" alt="" />
    <button class="lb-nav lb-next" id="lb-next" aria-label="Próxima foto">›</button>
    <span class="lb-contador" id="lb-contador"></span>
  </div>

  <script
    is:inline
    define:vars={{
      dados: dadosJs,
      urls: grandes.map((g) => g.src),
      legendas: LEGENDAS,
      titulo: d.titulo,
    }}
  >
    (function () {
      var etapas = Array.from(document.querySelectorAll('.etapa'));
      var fechoSec = document.getElementById('fecho');
      var percurso = document.getElementById('percurso');
      var barra = document.getElementById('barra');

      var respostas = {};
      var score = 0;

      /* ——— navegação: uma pergunta visível por vez, só avança por clique ——— */
      function mostraEtapa(i) {
        etapas.forEach(function (e, idx) { e.classList.toggle('ativa', idx === i); });
        fechoSec.classList.remove('ativa');
        barra.style.width = (i / etapas.length) * 100 + '%';
        etapas[i].scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
      function mostraFecho() {
        etapas.forEach(function (e) { e.classList.remove('ativa'); });
        fechoSec.classList.add('ativa');
        barra.style.width = '100%';
        fechoSec.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      document.getElementById('btn-comecar').addEventListener('click', function () {
        percurso.classList.add('iniciado');
        mostraEtapa(0);
      });

      function resumoTexto() {
        var partes = [];
        dados.etapas.forEach(function (e) {
          var r = respostas[e.id];
          if (r) partes.push('• ' + r.texto);
        });
        return partes.join('\n');
      }

      /* ——— perguntas ——— */
      etapas.forEach(function (secao, i) {
        var idEtapa = secao.dataset.etapa;
        var botaoAvancar = secao.querySelector('.avancar');

        var botaoVoltar = secao.querySelector('.voltar');
        if (botaoVoltar) {
          botaoVoltar.addEventListener('click', function () { mostraEtapa(i - 1); });
        }

        secao.querySelectorAll('.opcao').forEach(function (botao) {
          botao.addEventListener('click', function () {
            var idOpcao = botao.dataset.opcao;
            var jaRespondida = !!respostas[idEtapa];
            if (jaRespondida) score -= respostas[idEtapa].peso;

            respostas[idEtapa] = {
              opcao: idOpcao,
              texto: botao.querySelector('.opcao-txt').textContent,
              peso: Number(botao.dataset.peso),
              fechoTitulo: botao.dataset.fechoTitulo,
              fechoLead: botao.dataset.fechoLead,
            };
            score += Number(botao.dataset.peso);

            secao.querySelectorAll('.opcao').forEach(function (b) {
              b.classList.toggle('escolhida', b === botao);
              b.setAttribute('aria-pressed', b === botao ? 'true' : 'false');
            });
            secao.classList.add('respondida');

            var eco = secao.querySelector('[data-eco="' + idEtapa + ':' + idOpcao + '"]');
            secao.querySelectorAll('.eco').forEach(function (p) { p.classList.remove('visivel'); });
            if (eco) eco.classList.add('visivel');

            if (botaoAvancar) botaoAvancar.hidden = false;
          });
        });

        if (botaoAvancar) {
          botaoAvancar.addEventListener('click', function () {
            if (i + 1 < etapas.length) mostraEtapa(i + 1);
            else fecha();
          });
        }
      });

      document.getElementById('fecho-voltar').addEventListener('click', function () {
        mostraEtapa(etapas.length - 1);
      });

      /* ——— fecho: título e texto vêm direto da resposta da pergunta 6 ——— */
      function fecha() {
        var titulo = document.getElementById('fecho-titulo');
        var lead = document.getElementById('fecho-lead');
        var ultima = respostas[dados.etapas[dados.etapas.length - 1].id];

        if (ultima && ultima.fechoTitulo) {
          titulo.textContent = ultima.fechoTitulo;
          lead.textContent = ultima.fechoLead;
        }

        var lista = document.getElementById('resumo-lista');
        lista.innerHTML = '';
        dados.etapas.forEach(function (e) {
          var r = respostas[e.id];
          if (!r) return;
          var li = document.createElement('li');
          li.textContent = r.texto;
          lista.appendChild(li);
        });
        document.getElementById('resumo').hidden = false;

        mostraFecho();
      }

      /* ——— envio ———
         Dois caminhos de conversão: "Enviar mensagem" manda e-mail; "Falar
         no WhatsApp agora" faz o mesmo e ainda abre o WhatsApp sozinho. Esse
         segundo botão só aparece depois que nome e telefone são válidos. */
      var form = document.getElementById('form-lead');
      var erro = document.getElementById('form-erro');
      var btnEnviar = document.getElementById('btn-enviar');
      var btnWhats = document.getElementById('btn-whats');

      function nomeValido(v) { return v.trim().length > 1; }
      function telValido(v) { return v.replace(/\D/g, '').length >= 10; }

      function atualizaBotaoWhats() {
        btnWhats.hidden = !(nomeValido(form.nome.value) && telValido(form.telefone.value));
      }
      form.nome.addEventListener('input', atualizaBotaoWhats);
      form.telefone.addEventListener('input', atualizaBotaoWhats);

      function mostraObrigado(nome, telefone, abrirWhats) {
        var msg =
          'Olá Marcus, sou ' + nome + '. Vim pela página da casa térrea no Morada da Colina (CA5635).\n\n' +
          resumoTexto();
        var waHref = 'https://wa.me/' + dados.wa + '?text=' + encodeURIComponent(msg);
        document.getElementById('wa-final').href = waHref;

        document.getElementById('obrigado').hidden = false;
        document.body.style.overflow = 'hidden';

        if (abrirWhats) {
          setTimeout(function () { window.location.href = waHref; }, 1500);
        }
      }

      function enviarLead(botao, abrirWhats) {
        var nome = form.nome.value.trim();
        var telefone = form.telefone.value.trim();
        var email = form.email.value.trim();

        if (!nomeValido(nome) || !telValido(telefone)) {
          erro.textContent = 'Preciso do seu nome e de um WhatsApp com DDD.';
          erro.hidden = false;
          return;
        }
        erro.hidden = true;

        botao.disabled = true;
        var textoOriginal = botao.textContent;
        botao.textContent = 'Enviando…';

        var eventId = 'lp-ca5635-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
        var corpo = {
          nome: nome, telefone: telefone, email: email,
          imovel: 'CA5635 — Casa térrea de 4 suítes no Morada da Colina',
          score: score,
          respostas: dados.etapas.map(function (e) {
            var r = respostas[e.id];
            return r ? { pergunta: e.id, resposta: r.texto } : null;
          }).filter(Boolean),
        };

        /* Sinal para o Meta contar a conversão só aqui: o Pixel só dispara
           dentro deste clique, não em nenhum outro ponto da página. */
        fetch('/api/lead', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(corpo),
        })
          .catch(function () { /* o WhatsApp continua sendo o caminho, mesmo se o e-mail falhar */ })
          .then(function () {
            if (window.fbq) fbq('track', 'Lead', { content_name: 'CA5635' }, { eventID: eventId });
            fetch('/api/capi', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                event_name: 'Lead',
                event_id: eventId,
                event_source_url: window.location.href,
                contato: { email: email || undefined, telefone: telefone },
              }),
            }).catch(function () {});

            botao.textContent = textoOriginal;
            mostraObrigado(nome, telefone, abrirWhats);
          });
      }

      btnEnviar.addEventListener('click', function () { enviarLead(btnEnviar, false); });
      btnWhats.addEventListener('click', function () { enviarLead(btnWhats, true); });

      /* ——— lightbox: mostra só as fotos que já estavam juntas na tela ——— */
      var lb = document.getElementById('lightbox');
      var lbImg = document.getElementById('lb-img');
      var contador = document.getElementById('lb-contador');
      var listaAtual = [];
      var idx = 0;
      function mostra(i) {
        if (!listaAtual.length) return;
        idx = (i + listaAtual.length) % listaAtual.length;
        var n = Number(listaAtual[idx].dataset.n);
        lbImg.src = urls[n - 1];
        lbImg.alt = legendas[n - 1] + ' — ' + titulo;
        contador.textContent = idx + 1 + ' / ' + listaAtual.length;
      }
      function abre(elClicado) {
        var container = elClicado.closest('.lp-galeria');
        listaAtual = Array.from(container.querySelectorAll('.lp-foto'));
        mostra(listaAtual.indexOf(elClicado));
        lb.hidden = false;
        document.body.style.overflow = 'hidden';
      }
      function fechaLb() {
        lb.hidden = true;
        if (document.getElementById('obrigado').hidden) document.body.style.overflow = '';
      }
      document.querySelectorAll('.lp-foto').forEach(function (f) {
        f.addEventListener('click', function () { abre(f); });
      });
      document.getElementById('lb-fechar').addEventListener('click', fechaLb);
      document.getElementById('lb-prev').addEventListener('click', function () { mostra(idx - 1); });
      document.getElementById('lb-next').addEventListener('click', function () { mostra(idx + 1); });
      lb.addEventListener('click', function (e) { if (e.target === lb) fechaLb(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') fechaLb();
        if (e.key === 'ArrowLeft') mostra(idx - 1);
        if (e.key === 'ArrowRight') mostra(idx + 1);
      });

      /* ——— vídeo do topo: no desktop, altura exata entre o topo do título
         e o topo do parágrafo final ("...mais assertivo possível"), pedido
         do Marcus. No telefone o vídeo volta a ser 9:16 de largura total. */
      var video = document.getElementById('video-tour');
      var topoEl = document.querySelector('.lp-hero-topo');
      var notaEl = document.querySelector('.lp-hero-nota');
      function ajustaVideo() {
        if (window.innerWidth < 900) {
          video.style.height = '';
          video.style.width = '';
          video.style.maxWidth = '';
          return;
        }
        var alvo = notaEl.getBoundingClientRect().top - topoEl.getBoundingClientRect().top;
        if (alvo > 80) {
          video.style.height = alvo + 'px';
          video.style.width = 'auto';
          video.style.maxWidth = 'none';
        }
      }
      ajustaVideo();
      window.addEventListener('resize', ajustaVideo);
      window.addEventListener('load', ajustaVideo);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(ajustaVideo);
    })();
  </script>

  <style>
    /* ——— barra de progresso ——— */
    .lp-progresso {
      position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 40;
      background: color-mix(in srgb, var(--tinta) 10%, transparent);
    }
    .lp-progresso span {
      display: block; height: 100%; width: 0;
      background: var(--ciano); transition: width .5s cubic-bezier(.2,.7,.3,1);
    }

    /* ——— abertura ——— */
    .lp-hero { padding: 56px 0 28px; }
    .lp-hero-in {
      max-width: var(--maxw); margin: 0 auto; padding: 0 28px;
      display: grid; gap: 40px; align-items: start;
      grid-template-columns: 1fr;
    }
    .lp-hero-rot { color: var(--ciano-tinta); margin: 0 0 14px; }
    .lp-hero h1 {
      font-family: var(--display); font-size: clamp(2rem, 6.4vw, 3.4rem);
      line-height: 1.03; letter-spacing: -.028em; margin: 0 0 4px;
    }
    .lp-hero-lead { font-size: 1.12rem; margin: 0 0 22px; max-width: 42ch; }
    .lp-hero-preco {
      font-family: var(--display); font-weight: 600;
      font-size: clamp(1.5rem, 4.4vw, 2rem); letter-spacing: -.02em; margin: 0 0 20px;
    }
    .lp-hero-preco span {
      font-family: var(--corpo); font-weight: 400; font-size: .5em;
      color: var(--tinta-media); letter-spacing: 0; margin-left: 4px;
    }
    .lp-hero-nota { color: var(--tinta-media); max-width: 44ch; margin: 0 0 28px; }
    .lp-hero-btn { display: inline-block; border: 0; cursor: pointer; font: inherit; }

    .lp-hero-video { margin: 18px 0 26px; }
    .lp-hero-video video {
      width: 100%; max-width: 420px; aspect-ratio: 9 / 16; height: auto;
      display: block; border-radius: 14px; background: var(--papel-fundo);
      box-shadow: var(--sombra-alta); object-fit: cover;
    }

    /* No telefone a ordem é a do HTML: título, vídeo, texto. O vídeo é o
       gancho — ele não pode ficar embaixo de três parágrafos. */
    @media (min-width: 900px) {
      .lp-hero { padding: 84px 0 40px; }
      .lp-hero-in {
        grid-template-columns: 1.05fr .95fr;
        grid-template-areas: 'topo video' 'texto video';
        grid-template-rows: auto 1fr;
        gap: 18px 64px;
      }
      .lp-hero-topo { grid-area: topo; }
      .lp-hero-texto { grid-area: texto; }
      /* altura exata calculada via JS (ajustaVideo); align-self:start garante
         que o topo do vídeo cole no topo do título, como pedido — por isso
         zera a margem que no telefone separa o vídeo do título. */
      .lp-hero-video { grid-area: video; justify-self: end; align-self: start; margin-top: 0; }
    }

    /* ——— perguntas: uma por vez, só some quando "iniciado" ——— */
    .percurso { max-width: 780px; margin: 0 auto; padding: 0 28px 96px; }
    .percurso:not(.iniciado) { padding-bottom: 0; }
    .etapa, .fecho { display: none; }
    .etapa.ativa, .fecho.ativa { display: block; animation: entra .4s cubic-bezier(.2,.7,.3,1) both; }
    @keyframes entra {
      from { opacity: 0; transform: translateY(14px); }
      to { opacity: 1; transform: none; }
    }
    .etapa-in { padding: 40px 0; }
    .fecho-in { padding: 48px 0 0; }

    .voltar {
      display: inline-block; margin: 0 0 20px; padding: 0; border: 0; background: none;
      font-family: var(--mono); font-size: .78rem; letter-spacing: .03em;
      color: var(--tinta-fraca); cursor: pointer; transition: color .18s;
    }
    .voltar:hover { color: var(--ciano-tinta); }

    .etapa h2 {
      font-family: var(--display); font-size: clamp(1.45rem, 4.4vw, 2.05rem);
      line-height: 1.1; letter-spacing: -.022em; margin: 0 0 10px;
    }
    .etapa-apoio { color: var(--tinta-media); margin: 0 0 26px; }

    .opcoes { display: grid; gap: 12px; }
    .opcao {
      display: flex; align-items: center; gap: 14px; width: 100%;
      text-align: left; font: inherit; color: inherit; cursor: pointer;
      background: var(--papel-alto); border: 1px solid var(--traco);
      border-radius: 12px; padding: 17px 19px;
      transition: border-color .2s, background .2s, transform .2s, box-shadow .2s;
    }
    .opcao:hover { border-color: var(--traco-forte); transform: translateY(-1px); box-shadow: var(--sombra); }
    .opcao-txt { flex: 1; }
    .opcao-marca {
      flex: none; width: 21px; height: 21px; border-radius: 50%;
      border: 2px solid var(--traco-forte); position: relative; transition: all .2s;
    }
    .opcao.escolhida { border-color: var(--ciano); background: color-mix(in srgb, var(--ciano) 7%, var(--papel-alto)); }
    .opcao.escolhida .opcao-marca { border-color: var(--ciano); background: var(--ciano); }
    .opcao.escolhida .opcao-marca::after {
      content: ''; position: absolute; inset: 0; margin: auto;
      width: 6px; height: 10px; border: solid #fff; border-width: 0 2px 2px 0;
      transform: rotate(45deg) translate(-1px, -1px);
    }
    .etapa.respondida .opcao:not(.escolhida) { opacity: .5; }

    .ecos { margin-top: 22px; }
    .eco {
      display: none; margin: 0; padding: 16px 18px;
      background: color-mix(in srgb, var(--ciano) 6%, transparent);
      border-left: 3px solid var(--ciano); border-radius: 0 10px 10px 0;
      color: var(--tinta-media);
    }
    .eco.visivel { display: block; animation: entra .45s cubic-bezier(.2,.7,.3,1) both; }

    .avancar {
      display: inline-flex; align-items: center; gap: 8px; margin-top: 26px;
      border: 0; cursor: pointer; font: inherit;
      font-family: var(--display); font-weight: 600; font-size: 14px;
      background: var(--tinta); color: var(--papel); padding: 13px 22px;
      transition: background .18s, transform .18s;
    }
    .avancar:hover { background: var(--ciano-tinta); color: #fff; transform: translateY(-2px); }

    /* ——— fotos: já visíveis com a pergunta, sem depender do clique ——— */
    .lp-galeria-bloco { padding: 40px 0; border-top: 1px solid var(--traco); display: none; }
    .lp-galeria-rot { color: var(--ciano-tinta); margin: 0 0 18px; }
    .lp-galeria { display: flex; flex-wrap: wrap; gap: 10px; }
    .etapa-fotos { margin-bottom: 26px; }
    .lp-foto {
      flex: 1 1 calc(50% - 5px); min-width: 140px; position: relative;
      padding: 0; border: 0; background: var(--papel-fundo); cursor: pointer;
      border-radius: 10px; overflow: hidden; aspect-ratio: 4 / 3;
    }
    .lp-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .lp-foto-leg {
      position: absolute; inset: auto 0 0 0; padding: 26px 10px 8px;
      font-family: var(--mono); font-size: .62rem; letter-spacing: .01em;
      line-height: 1.3; text-transform: uppercase; color: #fff; text-align: left;
      background: linear-gradient(to top, rgba(10,16,28,.85), transparent);
    }
    @media (min-width: 640px) { .lp-foto { flex-basis: calc(33.333% - 7px); } }

    /* Sem JS: nada de wizard — todas as perguntas, o botão "Começar" e o
       acervo inteiro aparecem juntos, legíveis e completos. */
    :global(html:not(.js)) .etapa,
    :global(html:not(.js)) .fecho,
    :global(html:not(.js)) .lp-galeria-bloco { display: block !important; }
    :global(html:not(.js)) .voltar,
    :global(html:not(.js)) .avancar,
    :global(html:not(.js)) .lp-hero-btn,
    :global(html:not(.js)) .lp-progresso { display: none; }

    /* ——— fecho ——— */
    .fecho h2 {
      font-family: var(--display); font-size: clamp(1.5rem, 4.6vw, 2.15rem);
      line-height: 1.08; letter-spacing: -.022em; margin: 10px 0 12px;
    }
    .fecho-lead { margin: 0 0 26px; max-width: 46ch; }
    .resumo {
      background: var(--papel-alto); border: 1px solid var(--traco);
      border-radius: 12px; padding: 18px 20px; margin: 0 0 26px;
    }
    .resumo .rotulo { color: var(--ciano-tinta); }
    .resumo ul { margin: 10px 0 0; padding-left: 18px; color: var(--tinta-media); }
    .resumo li { margin: 4px 0; }

    .form { display: grid; gap: 14px; max-width: 460px; }
    .form label { display: grid; gap: 6px; }
    .form label span {
      font-family: var(--mono); font-size: .74rem; letter-spacing: .06em;
      text-transform: uppercase; color: var(--tinta-media);
    }
    .form label em { font-style: normal; opacity: .7; text-transform: none; letter-spacing: 0; }
    .form input {
      font: inherit; color: inherit; background: var(--papel-alto);
      border: 1px solid var(--traco); border-radius: 10px; padding: 13px 15px;
      transition: border-color .2s;
    }
    .form input:focus { border-color: var(--ciano); outline: none; }

    .fecho-botoes { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
    .fecho-botoes button { border: 0; cursor: pointer; font: inherit; }
    .fecho-botoes button[disabled] { opacity: .6; cursor: default; }

    .form-nota { font-size: .86rem; color: var(--tinta-fraca); margin: 0; }
    .form-nota a { text-decoration: underline; }
    .form-erro { color: #b3261e; margin: 0; font-size: .92rem; }

    /* ——— agradecimento: cobre a tela inteira ——— */
    .obrigado[hidden] { display: none; }
    .obrigado:not([hidden]) {
      position: fixed; inset: 0; z-index: 70; background: var(--papel);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 40px; animation: entra .5s cubic-bezier(.2,.7,.3,1) both;
    }
    .obrigado-sub { font-size: 1.15rem; color: var(--tinta-media); margin: 0 0 8px; }
    .obrigado-grande {
      font-family: var(--display); font-weight: 700; letter-spacing: -.02em;
      font-size: clamp(2.6rem, 8vw, 4.4rem); margin: 0 0 34px; color: var(--tinta);
    }
    .obrigado .btn-wa { border: 0; cursor: pointer; font: inherit; }

    @media (prefers-reduced-motion: reduce) {
      .etapa.ativa, .fecho.ativa, .eco.visivel, .obrigado { animation: none; }
    }
  </style>
