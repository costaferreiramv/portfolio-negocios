  { t: 'Apartamentos 301 e 302', s: '3º pavimento', area: '310,29', suites: '4 suítes', vagas: '4 vagas',
    itens: ['Suíte máster com closet e varanda', 'Suíte com varanda', 'Varanda gourmet', 'Hall privativo'], img: r('planta-ap-301-302', 'Planta dos apartamentos 301 e 302') },
  { t: 'Apartamentos 401 e 402', s: '4º pavimento', area: '294,54', suites: '4 suítes', vagas: '4 vagas',
    itens: ['Suíte máster com closet e varanda', 'Suíte com varanda', 'Varanda gourmet', 'Hall privativo'], img: r('planta-ap-401-402', 'Planta dos apartamentos 401 e 402') },
  { t: 'Apartamentos 501 e 502', s: '5º pavimento', area: '279,19', suites: '4 suítes', vagas: '4 vagas',
    itens: ['Suíte máster com closet e varanda', 'Suíte com varanda', 'Varanda gourmet', 'Hall privativo'], img: r('planta-ap-501-502', 'Planta dos apartamentos 501 e 502') },
  { t: 'Apartamentos 601 e 602', s: '6º pavimento', area: '263,01', suites: '4 suítes', vagas: '4 vagas',
    itens: ['Suíte máster com closet e varanda', 'Suíte com varanda', 'Varanda gourmet', 'Hall privativo'], img: r('planta-ap-601-602', 'Planta dos apartamentos 601 e 602') },
];

const FICHA_EMPREENDIMENTO = [
  'Terreno com 3.000 m²',
  'Área construída com 19.102,80 m²',
  'Torre única, 26 pavimentos',
  '2 apartamentos por andar, 52 no total',
  '2 apartamentos: 4 suítes, 310,29 m², 4 vagas',
  '2 apartamentos: 4 suítes, 294,54 m², 4 vagas',
  '2 apartamentos: 4 suítes, 279,19 m², 4 vagas',
  '2 apartamentos: 4 suítes, 263,01 m², 4 vagas',
  '42 apartamentos tipo: 4 suítes, 247,13 m², 3 vagas',
  '2 apartamentos duplex: 428,58 m², 4 vagas',
  '170 vagas, 3 para PCD e 4 para visitantes',
  '3 elevadores: 2 sociais e 1 de serviço',
];
const FICHA_LAZER = [
  'Hall', 'Salão de festas', 'Churrasqueira do salão de festas', 'Espaço gourmet', 'Brinquedoteca',
  'Playground', 'Sala de jogos', 'Quadra poliesportiva', 'Quadra de beach tennis',
  'Churrasqueira das quadras', 'Coworking', 'Academia', 'Sauna', 'Sala de massagem', 'Espaço beauty',
  'Pool house', 'Bar da pool house', 'Solário', 'Piscina', 'Deck molhado', 'Espaço delivery', 'Minimercado',
];

const descricao =
  'Loren Residence, lançamento no Altamira, Uberlândia: apartamentos de 4 suítes a partir de 247 m², lazer completo, vídeo do apartamento decorado e plantas. Agende sua experiência no decorado.';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ApartmentComplex',
  name: 'Loren Residence',
  description: descricao,
  url: URL_PAGINA,
  image: new URL('/loren/og.jpg', Astro.site).href,
  numberOfAccommodationUnits: 52,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Avenida Presidente Médici, 190',
    addressLocality: 'Uberlândia',
    addressRegion: 'MG',
    addressCountry: 'BR',
  },
};

const hero = r('hero', 'Textura marinho com veios dourados');
const logo = { src: `${D}loren-logo.png`, w: 710, h: 242 };
const cred = { ...r('creditos', 'Incorporação: Luduna e Rodoban. Construção: Laso Engenharia'), src: `${D}creditos.png` };
---

<LP
  title="Loren Residence, lançamento no Altamira, Uberlândia | Portfólio Negócios"
  description={descricao}
  image="/loren/og.jpg"
  canonical={URL_PAGINA}
  jsonLd={jsonLd}
>
  <!-- marca do Portfólio, fixa no canto superior esquerdo durante toda a rolagem -->
  <div class="lr-marca">
    <img src={`${D}portfolio-logo.png`} width="180" height="258" alt="Portfólio Negócios Imobiliários" />
  </div>

  <!-- ————————————————— ABERTURA ————————————————— -->
  <header class="lr-hero">
    <img class="lr-hero-bg" src={hero.src} srcset={hero.srcset} sizes="100vw" width={hero.w} height={hero.h}
         alt="" fetchpriority="high" />
    <div class="lr-hero-in">
      <img class="lr-logo" src={logo.src} width={logo.w} height={logo.h} alt="Loren Residence" />
      <p class="lr-hero-frase">Onde a vida encontra <em>espaço para evoluir</em></p>
      <p class="lr-hero-meta">Lançamento · Altamira · Uberlândia</p>
    </div>
    <span class="lr-rolar" aria-hidden="true"></span>
  </header>

  <!-- ————————————————— CONCEITO ————————————————— -->
  <section class="lr-sec lr-intro">
    <div class="lr-wrap lr-intro-grade">
      <figure class="lr-fig lr-reveal">
        <img src={`${D}familia-800.webp`} srcset={`${D}familia-800.webp 800w, ${D}familia.webp 1800w`}
             sizes="(max-width:900px) 92vw, 46vw" width="1800" height="1217" loading="lazy"
             alt="Pai e filho se abraçando, sorrindo (imagem ilustrativa)" />
      </figure>
      <div class="lr-txt lr-reveal">
        <p class="lr-rot">O Loren</p>
        <h2>Entre imponência e leveza, <em>presença e tranquilidade</em></h2>
        <p>A cidade cresce, as expectativas evoluem e as escolhas passam a refletir uma nova forma de viver. O Loren nasce para esse momento: um residencial desenhado para acompanhar uma vida que continua em movimento.</p>
        <p>Um endereço que responde ao presente, mas permanece à altura dos próximos capítulos.</p>
      </div>
    </div>
  </section>

  <section class="lr-nums" aria-label="O empreendimento em números">
    <ul class="lr-wrap">
      {NUMEROS.map((x) => (
        <li><strong>{x.n}</strong><span>{x.t}</span></li>
      ))}
    </ul>
    <p class="lr-nums-nota">Opções de cobertura duplex</p>
  </section>

  <!-- ————————————————— O PROJETO ————————————————— -->
  <section class="lr-sec lr-projeto">
    <div class="lr-wrap lr-cab lr-reveal">
      <p class="lr-rot">O projeto</p>
      <h2>O horizonte de <em>uma nova fase</em></h2>
    </div>
    <figure class="lr-pleno lr-reveal">
      <img src={`${D}fachada-noite.webp`} width="1368" height="768" loading="lazy"
           sizes="100vw" alt="Fachada do Loren ao entardecer (imagem ilustrativa)" />
      <figcaption>Imagem ilustrativa</figcaption>
    </figure>
    <div class="lr-wrap lr-duo">
      <figure class="lr-fig lr-fig-alta lr-reveal">
        <img src={`${D}fachada-detalhe-800.webp`} srcset={`${D}fachada-detalhe-800.webp 800w, ${D}fachada-detalhe.webp 1715w`}
             sizes="(max-width:900px) 92vw, 46vw" width="1715" height="1444" loading="lazy"
             alt="Detalhe da fachada com varandas e palmeiras (imagem ilustrativa)" />
        <figcaption>Imagem ilustrativa</figcaption>
      </figure>
      <div class="lr-txt lr-reveal">
        <h3>Chegar passa a ter <em>outro significado</em></h3>
        <p>A portaria com porte-cochère oferece segurança e conforto em todos os momentos de chegada. Funcional e imponente, o acesso antecipa a elegância presente em todo o Loren.</p>
        <figure class="lr-fig lr-fig-hall">
          <img src={`${D}hall-800.webp`} srcset={`${D}hall-800.webp 800w, ${D}hall.webp 1800w`}
               sizes="(max-width:900px) 92vw, 46vw" width="1800" height="682" loading="lazy"
               alt="Hall de entrada com proporções generosas (imagem ilustrativa)" />
          <figcaption>Hall de entrada · imagem ilustrativa</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ————————————————— LOCALIZAÇÃO ————————————————— -->
  <section class="lr-sec lr-local">
    <div class="lr-wrap lr-local-grade">
      <div class="lr-txt lr-reveal">
        <p class="lr-rot">Localização</p>
        <h2>Perto de tudo o que <em>faz sentido</em> para a sua rotina</h2>
        <p class="lr-local-lead">A menos de 10 minutos do centro.</p>
        <ul class="lr-dist">
          {DISTANCIAS.map((d) => (
            <li><b>{d.m} min</b><span>{d.t}</span></li>
          ))}
        </ul>
        <p class="lr-end">Avenida Presidente Médici, 190<br />Altamira · Uberlândia</p>
      </div>
      <figure class="lr-fig lr-fig-mapa lr-reveal">
        <img src={`${D}mapa-800.webp`} srcset={`${D}mapa-800.webp 800w, ${D}mapa.webp 2000w`}
             sizes="(max-width:900px) 92vw, 52vw" width="2000" height="1313" loading="lazy"
             alt="Mapa ilustrado com o Loren e os pontos de referência do entorno" />
        <figcaption>Mapa ilustrativo, sem escala</figcaption>
      </figure>
    </div>
    <div class="lr-wrap lr-cidade lr-reveal">
      <figure class="lr-fig">
        <img src={`${D}uberlandia-noite-800.webp`} srcset={`${D}uberlandia-noite-800.webp 800w, ${D}uberlandia-noite.webp 1800w`}
             sizes="(max-width:900px) 92vw, 56vw" width="1800" height="1014" loading="lazy"
             alt="Vista aérea de Uberlândia ao anoitecer" />
      </figure>
      <div class="lr-txt">
        <h3>Uma nova perspectiva <em>para Uberlândia</em></h3>
        <p>No coração do Triângulo Mineiro, a cidade vive um novo momento. Hoje, localização e metragem já não definem uma escolha por si só: arquitetura, bem-estar e permanência ganham cada vez mais relevância.</p>
      </div>
    </div>
  </section>

  <!-- ————————————————— LAZER ————————————————— -->
  <section class="lr-sec lr-lazer">
    <div class="lr-wrap lr-cab lr-reveal">
      <p class="lr-rot">Lazer</p>
      <h2>Um andar inteiro dedicado a <em>cada momento</em></h2>
      <p class="lr-sub">Vinte e uma experiências reunidas no pilotis, do esporte ao descanso.</p>
    </div>
    <div class="lr-wrap lr-pilotis lr-reveal">
      <img src={`${D}pilotis.webp`} width="1750" height="1003" loading="lazy"
           alt="Planta ilustrativa do pilotis com todos os ambientes de lazer" />
      <ol class="lr-legenda">
        {LEGENDA_PILOTIS.map((n) => <li>{n}</li>)}
      </ol>
    </div>
    <div class="lr-wrap">
      <ul class="lr-mosaico">
        {LAZER.map((a) => (
          <li class:list={['lr-tile', 'lr-reveal', a.grande && 'lr-tile-g', a.larga && 'lr-tile-l']}>
            <button type="button" class="lr-zoom lr-tile-btn" data-full={a.src} data-alt={a.alt} aria-label={`Ampliar: ${a.t}`}>
              <img src={a.src} srcset={a.srcset} sizes={a.grande ? '(max-width:1220px) 92vw, 1124px' : '(max-width:700px) 92vw, 552px'}
                   width={a.w} height={a.h} loading="lazy" alt={a.alt} />
              <span class="lr-tile-leg"><b>{a.t}</b><span>{a.d}</span></span>
            </button>
          </li>
        ))}
      </ul>
      <p class="lr-nota">Imagens ilustrativas, assim como equipamentos, acessórios e paisagismo.</p>
    </div>
  </section>

  <!-- ————————————————— DECORADO ————————————————— -->
  <section class="lr-sec lr-decorado">
    <img class="lr-aq lr-aq-dec" src={`${D}aq-teal-800.webp`} alt="" width="800" height="382" loading="lazy" />
    <div class="lr-wrap lr-cab lr-reveal">
      <p class="lr-rot">Apartamento decorado</p>
      <h2>Conheça o Loren <em>por dentro</em></h2>
      <p class="lr-sub">Conheça o decorado em vídeo, encante-se com as fotos de cada ambiente.</p>
    </div>
    <div class="lr-wrap lr-dec-grade">
      <div class="lr-video-col lr-reveal">
        <div class="lr-video">
          <video controls playsinline preload="metadata" poster={`${D}decorado-poster.webp`}
                 aria-label="Vídeo completo do apartamento decorado do Loren" id="lr-video">
            <source src={`${D}decorado.mp4`} type="video/mp4" />
            Seu navegador não reproduz vídeo.
          </video>
        </div>
        <p class="lr-video-leg">Vídeo do apartamento decorado · 1 min 46 s</p>
      </div>
      <ul class="lr-fotos">
        {DECORADO.map((p) => (
          <li class="lr-reveal">
            <button type="button" class="lr-zoom" data-full={p.src} data-alt={p.alt} aria-label={`Ampliar: ${p.alt}`}>
              <img src={p.src} srcset={p.srcset} sizes="(max-width:700px) 46vw, (max-width:1100px) 30vw, 22vw"
                   width={p.w} height={p.h} loading="lazy" alt={p.alt} />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ————————————————— PLANTAS ————————————————— -->
  <section class="lr-sec lr-plantas">
    <div class="lr-wrap lr-cab lr-reveal">
      <p class="lr-rot">Plantas</p>
      <h2>Amplas, com integrações <em>bem resolvidas</em></h2>
      <p class="lr-sub">De 247 a 428 m². Possibilidade de adaptação de 4 ou 3 suítes, para acompanhar diferentes formas de viver, hoje e ao longo do tempo.</p>
    </div>
    <div class="lr-wrap lr-pl-grade">
      {PLANTAS.map((p) => (
        <article class="lr-pl lr-reveal">
          <div class="lr-pl-cab">
            <div>
              <h3>{p.t}</h3>
              <p class="lr-pl-sub">{p.s}</p>
            </div>
            <p class="lr-pl-area"><strong>{p.area}</strong> m²</p>
          </div>
          <button type="button" class="lr-zoom lr-zoom-pl" data-full={p.img.src} data-alt={p.img.alt} aria-label={`Ampliar: ${p.img.alt}`}>
            <img src={p.img.src} width={p.img.w} height={p.img.h} loading="lazy" alt={p.img.alt} />
          </button>
          <p class="lr-pl-chips"><span>{p.suites}</span><span>{p.vagas}</span></p>
          <ul>
            {p.itens.map((i) => <li>{i}</li>)}
          </ul>
        </article>
      ))}
    </div>

    <div class="lr-wrap lr-dup lr-reveal">
      <div class="lr-dup-txt">
        <p class="lr-rot">Coberturas duplex · 2501 e 2502</p>
        <h3>Proporções à altura <em>das suas escolhas</em></h3>
        <p class="lr-dup-area"><strong>428,58</strong> m² · 4 vagas</p>
        <ul>
          <li>Suíte máster com closet, banho sr. e sra. e banheira*</li>
          <li>Varanda em todas as suítes</li>
          <li>Elevador com acesso aos dois pavimentos</li>
          <li>Terraço descoberto com previsão para piscina* (área descoberta de 59,80 m²)</li>
        </ul>
        <p class="lr-nota-fixa">*Não inclui equipamentos.</p>
      </div>
      <figure class="lr-fig lr-dup-img">
        <img src={`${D}cobertura-sala-800.webp`} srcset={`${D}cobertura-sala-800.webp 800w, ${D}cobertura-sala.webp 1800w`}
             sizes="(max-width:900px) 92vw, 52vw" width="1800" height="759" loading="lazy"
             alt="Sala de estar da cobertura duplex (imagem ilustrativa)" />
        <figcaption>Sala da cobertura duplex · imagem ilustrativa</figcaption>
      </figure>
    </div>
    <div class="lr-wrap lr-dup-pl lr-reveal">
      <button type="button" class="lr-zoom lr-zoom-pl" data-full={`${D}planta-duplex-n1.webp`} data-alt="Planta da cobertura duplex, 1º nível" aria-label="Ampliar: planta da cobertura duplex, 1º nível">
        <img src={`${D}planta-duplex-n1.webp`} width="1200" height="1037" loading="lazy" alt="Planta da cobertura duplex, 1º nível" />
        <span>1º nível</span>
      </button>
      <button type="button" class="lr-zoom lr-zoom-pl" data-full={`${D}planta-duplex-n2.webp`} data-alt="Planta da cobertura duplex, 2º nível" aria-label="Ampliar: planta da cobertura duplex, 2º nível">
