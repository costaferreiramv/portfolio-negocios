const PLANTAS = [
  { t: 'Apartamento tipo', s: '7º ao 24º pavimento', area: '247,10', suites: '4 suítes', vagas: '3 vagas',
    itens: ['Suíte máster com closet e varanda', 'Suíte com varanda', 'Varanda gourmet', 'Hall privativo'], img: r('planta-tipo', 'Planta do apartamento tipo de 4 suítes') },
  { t: 'Tipo com sala ampliada', s: '7º ao 24º pavimento', area: '247,13', suites: '3 suítes', vagas: '3 vagas',
